---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { socials } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);

// The home page shows the three most recent posts from each track, newest first.
const PER_CATEGORY = 3;
const recentPosts = (["projects", "ventures"] as const)
  .flatMap(category =>
    sortedPosts
      .filter(({ data }) => data.category === category)
      .slice(0, PER_CATEGORY)
  )
  .sort(
    (a, b) =>
      (b.data.pubDatetime?.getTime() ?? 0) - (a.data.pubDatetime?.getTime() ?? 0)
  );

const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout my-1"
  >
    <section id="hero" class="border-border border-b pt-8 pb-6">
      <a
        target="_blank"
        href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`}
        class="inline-block"
        aria-label="RSS Feed"
        title="RSS Feed"
      >
        <IconRss
          width={20}
          height={20}
          class="stroke-accent scale-125 stroke-3 rtl:-rotate-90"
        />
        <span class="sr-only">RSS Feed</span>
      </a>

      <p>
        I&rsquo;m <LinkButton
          class="font-bold underline decoration-dashed underline-offset-4"
          href="https://farhansadeek.com"
          target="_blank"
          rel="noopener noreferrer">Farhan Sadeek</LinkButton
        >, a computer science undergraduate at Columbia. I spend most of my time tinkering with large language models, robots and computer chips. I try to write a blog about such endeavors which are documented in this blog. I occasionally write about startups that I find interesting, which are on the ventures section of the page. Feel free to contact me on the the links below!  
      </p>
      <p class="mt-2">
        Two kinds of writing live on this site.
        <strong>Projects</strong> are experiments I ran myself: the setup, the numbers,
        and an explicit note on what the numbers do <em>not</em> prove.
        <strong>Ventures</strong> are memos on the companies building the hardware,
        inference stacks, and agent tooling underneath all of it &mdash; separating
        the verified from the company-reported.
      </p>
      <p class="mt-2">
        Nothing here is a press release. Every run is reproducible from the
        scripts, and every claim I can&rsquo;t back up is labelled as such.
      </p>
      {
        socials.length > 0 && (
          <div class="mt-4 flex max-sm:flex-col sm:items-center">
            <div class="me-2 mb-1 whitespace-nowrap sm:mb-0">
              {t.home.socialLinks}:
            </div>
            <Socials />
          </div>
        )
      }
    </section>

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.recentPosts}
          </h2>
          <ul>
            {recentPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton href={getRelativeLocaleUrl(locale, "posts")}>
        {t.home.allPosts}
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
